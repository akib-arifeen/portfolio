# Copy to .env.local and fill in. Never commit .env.local.
KIE_API_KEY=
# GPT Image 2.5 Flare (fast) by default; use gpt-image-2-5-sunburst-image-to-image for higher quality
KIE_IMAGE_MODEL=gpt-image-2-5-flare-image-to-image
# 1 = free test mode (returns your own photo, spends no credits). Local use only: leave it empty in production.
BOOTH_MOCK=
